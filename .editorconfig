root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Kotlin and Swift conventionally use four.
[*.{kt,kts}]
indent_size = 4

[*.swift]
indent_size = 4

# Generated fixtures are tab-separated and column-aligned; leave them alone.
[*.tsv]
indent_style = tab
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
